# ===================================
# DỰ ÁN: ĂN CƠM (Eat Rice) - ENVIRONMENT VARIABLES
# ===================================

# Server Port
PORT=5000

# Client API Base URL
VITE_API_BASE_URL=http://localhost:5000/api

# Firebase Firestore Configuration (Server side)
# Optional: If omitted, server will automatically fallback to in-memory/file storage engine for quick testing!
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-firebase-service-account-email@project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Allowed CORS Origins
ALLOWED_ORIGIN=http://localhost:3000,http://localhost:5173,https://ancom.vercel.app

# Google AdSense Client ID (Optional)
VITE_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX
