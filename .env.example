# ===================================
# DỰ ÁN: ĂN CƠM (Eat Rice) - ENVIRONMENT VARIABLES
# ===================================

# Backend API base URL. Defaults to the production VPS backend
# (https://ancom-api.sumflow.online/api) if not set — only override this for
# local development against a backend running on your own machine.
VITE_API_BASE_URL=https://ancom-api.sumflow.online/api

# Google AdSense Client ID
VITE_ADSENSE_CLIENT_ID=ca-pub-9103455158021249

# Google Analytics 4 Measurement ID (format: G-XXXXXXXXXX).
# Tạo tại https://analytics.google.com -> Admin -> Data Streams -> Web.
# Để trống thì site vẫn chạy bình thường, chỉ là không có gtag.js nào được nhúng.
VITE_GA_MEASUREMENT_ID=
