# ===================================
# ĂN CƠM BACKEND - ENVIRONMENT VARIABLES
# ===================================
# Copy this file to `.env` in the same directory (backend/) before running
# `docker compose up -d --build` — docker-compose.yml reads DEEPSEEK_API_KEY
# and the recipe rate-limit values from that file.

# DeepSeek API key (https://platform.deepseek.com/api_keys) — powers the
# "AI advice" features (recipe, hydration, workout, sleep). Leave empty to
# disable them; /api/advice/:type responds 503 instead of failing to start.
DEEPSEEK_API_KEY=

# Max AI advice calls per device per day, shared across all 4 advice types
# (cost control).
AI_DAILY_LIMIT_PER_DEVICE=8

# Max AI advice calls site-wide per day (hard cost cap regardless of
# traffic spikes), shared across all 4 advice types.
AI_DAILY_GLOBAL_LIMIT=400
