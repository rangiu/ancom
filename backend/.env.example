# ===================================
# ĂN CƠM BACKEND - ENVIRONMENT VARIABLES
# ===================================
# Copy this file to `.env` in the same directory (backend/) before running
# `docker compose up -d --build` — docker-compose.yml reads DEEPSEEK_API_KEY
# and the recipe rate-limit values from that file.

# DeepSeek API key (https://platform.deepseek.com/api_keys) — powers the
# "AI gợi ý món ăn" (AI recipe suggestion) feature. Leave empty to disable
# it; the endpoint responds 503 instead of failing to start.
DEEPSEEK_API_KEY=

# Max AI recipe suggestions per device per day (cost control).
RECIPE_DAILY_LIMIT_PER_DEVICE=5

# Max AI recipe suggestions site-wide per day (hard cost cap regardless of
# traffic spikes).
RECIPE_DAILY_GLOBAL_LIMIT=300
